generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  DELETED
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum HierarchyStatus {
  ACTIVE
  ARCHIVED
}

// Phase 5: discriminator for the Client entity — an individual person or an
// organization (plan/legal counterparty). Deliberately not an organization-hierarchy
// entity; a Client organization is a counterparty, while Organization/Branch/
// Department/Team are the practice's own structure (Phase 4). See Phase 7 for
// separating legal parties from clients.
enum ClientType {
  INDIVIDUAL
  ORGANIZATION
}

// Phase 5 follow-up: how a Client can be contacted. Strict enough to be an enum;
// a client is not expected to carry arbitrary, open-ended contact kinds.
enum ClientContactType {
  PHONE
  EMAIL
  FAX
  WEBSITE
  MOBILE
}

// Phase 5 follow-up: the role/purpose of a Client's physical address.
enum ClientAddressType {
  MAILING
  BILLING
  REGISTERED
  BRANCH
}

// Phase 6: Conflict Check workflow lifecycle status. A check starts PENDING,
// moves to IN_REVIEW when a reviewer begins evaluation, and reaches the
// terminal COMPLETED state once a final decision (ALLOW/BLOCK) is recorded.
enum ConflictCheckStatus {
  PENDING
  IN_REVIEW
  COMPLETED
}

// Phase 6: the final decision recorded on a ConflictCheck. A PENDING decision
// means no reviewer has finalized yet; ALLOW means no conflict was found (or
// the conflict was deemed manageable); BLOCK means the conflict is prohibitive
// and a future matter/case acceptance must not proceed.
enum ConflictDecision {
  PENDING
  ALLOW
  BLOCK
}

// Phase 6: kind of prospective party on a ConflictCheck — either a direct
// party (plaintiff, defendant, etc.) or a related entity (parent company,
// subsidiary, affiliated org, etc.).
enum ConflictPartyType {
  PARTY
  RELATED_ENTITY
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  EXPIRED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  REJECTED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RoleScope {
  GLOBAL
  TENANT
}

enum DenialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuditCategory {
  AUDIT
  SECURITY
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED
  REVOKED
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
  PRIVILEGED
  RESTRICTED
}

// Phase 1: Health check table to prove migrations work
model Health {
  id        String   @id @default(uuid())
  status    String   @default("OK")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// Phase 1: Storage security metadata foundation.
model StorageObject {
  id               String    @id @default(uuid())
  tenantId         String
  key              String
  versionId        String?
  sha256           String    @db.VarChar(64)
  sizeBytes        BigInt
  contentType      String
  encryptionMode   String
  malwareStatus    String    @default("PENDING_SCAN")
  malwareScannedAt DateTime?
  retentionUntil   DateTime?
  legalHold        Boolean            @default(false)
  classification   DataClassification @default(CONFIDENTIAL)
  metadata         Json?
  createdAt        DateTime           @default(now())
  deletedAt        DateTime?
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([key, versionId])
  @@index([malwareStatus, createdAt])
  @@index([retentionUntil, legalHold])
  @@index([tenantId, createdAt])
}

// Phase 1: Transactional outbox table skeleton
model OutboxMessage {
  id             String    @id @default(uuid())
  tenantId       String?
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  status         String    @default("PENDING") // PENDING, PROCESSING, PROCESSED, FAILED, DEAD_LETTER
  error          String?
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  claimedAt      DateTime?
  leaseToken     String?
  deadLetteredAt DateTime?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status, availableAt, createdAt])
  @@index([status, claimedAt])
  @@index([aggregateType, aggregateId])
  @@index([tenantId, status, availableAt])
}

// Phase 1: Idempotency registry skeleton
enum IdempotencyState {
  RESERVED
  COMPLETED
  FAILED
}

model IdempotencyKey {
  // Phase 2: typed server-derived tenant boundary. tenantScope remains the
  // persisted string lookup scope; tenantId is the typed FK used by RLS.
  id              String             @id @default(uuid())
  key             String
  actorScope      String?
  tenantScope     String?
  tenantId        String?
  method          String
  route           String
  fingerprint     String
  state           IdempotencyState   @default(RESERVED)
  responseStatus  Int?
  responseBody    Json?
  responseHeaders Json?
  attemptVersion  Int                @default(0)
  reservedAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  expiresAt       DateTime
  requestId       String?
  tenant          Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "IdempotencyKey_tenantId_fkey")

  @@unique([key, actorScope, tenantScope, method, route])
  @@index([expiresAt])
  @@index([state, expiresAt])
  @@index([tenantId])
}

// Phase 2: Global application identity. Provider credentials and MFA secrets are not stored here.
model User {
  id                    String                 @id @default(uuid())
  status                UserStatus             @default(PENDING)
  emailNormalized       String?                @unique
  displayName           String?
  givenName             String?
  familyName            String?
  locale                String                 @default("en")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  externalIdentities    ExternalIdentity[]
  sessions              AppSession[]
  memberships           Membership[]
  globalRoleAssignments GlobalRoleAssignment[]
  denials               AccessDenial[]         @relation("DenialSubjectUser")
  auditEvents           AuditEvent[]           @relation("AuditActorUser")
  platformBootstraps    PlatformBootstrap[]    @relation("BootstrapOperatorUser")

  @@index([status, createdAt])
}

// Phase 2: Immutable provider subject mapping. Email matching never links identities implicitly.
model ExternalIdentity {
  id                  String    @id @default(uuid())
  userId              String
  provider            String
  subject             String
  providerSessionId   String?
  lastAuthenticatedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@index([userId])
}

// Phase 2: Server-mediated opaque application session. Tokens are stored only as hashes/ciphertext.
model AppSession {
  id                             String        @id @default(uuid())
  userId                         String
  tokenHash                      String        @unique
  csrfTokenHash                  String        @unique
  status                         SessionStatus @default(ACTIVE)
  provider                       String
  providerSubject                String
  providerSessionId              String?
  activeTenantId                 String?
  activeMembershipId             String?
  contextVersion                 Int           @default(0)
  createdAt                      DateTime      @default(now())
  lastUsedAt                     DateTime      @default(now())
  idleExpiresAt                  DateTime
  absoluteExpiresAt              DateTime
  mfaVerifiedAt                  DateTime?
  mfaAcr                         String?
  mfaAmr                         Json?
  providerRefreshTokenCiphertext String?
  providerRefreshTokenKeyVersion String?
  providerIdTokenCiphertext      String?
  userAgentHash                  String?
  ipHash                         String?
  revokedAt                      DateTime?
  revokedReason                  String?
  user                           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeTenant                   Tenant?       @relation("SessionActiveTenant", fields: [activeTenantId], references: [id], onDelete: SetNull)
  activeMembership               Membership?   @relation("SessionActiveMembership", fields: [activeMembershipId, activeTenantId], references: [id, tenantId], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, activeTenantId, status])
  @@index([activeTenantId, status])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

// Phase 2: Primary ordinary data-security boundary.
model Tenant {
  id                 String           @id @default(uuid())
  slug               String           @unique
  name               String
  externalIdentifier String?          @unique
  status             TenantStatus     @default(PENDING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  archivedAt         DateTime?
  organizations      Organization[]
  branches           Branch[]
  clients            Client[]
  clientContacts     ClientContact[]
  clientAddresses    ClientAddress[]
  departments        Department[]
  teams              Team[]
  memberships        Membership[]
  activeSessions     AppSession[]     @relation("SessionActiveTenant")
  invitations        Invitation[]
  roles              Role[]
  denials            AccessDenial[]
  teamMembers        TeamMember[]
  storageObjects     StorageObject[]
  outboxMessages     OutboxMessage[]
  auditEvents        AuditEvent[]
  platformBootstraps PlatformBootstrap[]
  idempotencyKeys    IdempotencyKey[]
  organizationSettings OrganizationSetting[]
  conflictChecks      ConflictCheck[]
  conflictParties     ConflictParty[]

  @@index([status, createdAt])
}

model Organization {
  id        String          @id @default(uuid())
  tenantId  String
  slug      String
  name      String
  status    HierarchyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches  Branch[]

  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model Branch {
  id             String          @id @default(uuid())
  tenantId       String
  organizationId String
  slug           String
  name           String
  status         HierarchyStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization   Organization    @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  departments    Department[]

  @@unique([id, tenantId])
  @@unique([tenantId, organizationId, slug])
  @@index([tenantId, status])
}

model Department {
  id        String          @id @default(uuid())
  tenantId  String
  branchId  String
  slug      String
  name      String
  status    HierarchyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch    Branch          @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, branchId, slug])
  @@index([tenantId, status])
}

// Team is an assignment construct, not an alternate security boundary.
model Team {
  id          String          @id @default(uuid())
  tenantId    String
  slug        String
  name        String
  description String?
  status      HierarchyStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  members     TeamMember[]

  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

// Membership is the source of ordinary tenant context.
model Membership {
  id              String           @id @default(uuid())
  tenantId        String
  userId          String
  status          MembershipStatus @default(INVITED)
  activeFrom      DateTime?
  activeUntil     DateTime?
  invitedAt       DateTime?
  activatedAt     DateTime?
  suspendedAt     DateTime?
  removedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeSessions  AppSession[]     @relation("SessionActiveMembership")
  roles           MembershipRole[]
  teamMembers     TeamMember[]
  invitationsSent Invitation[]     @relation("InvitationInviterMembership")
  denialsCreated  AccessDenial[]   @relation("DenialCreatedByMembership")
  auditEvents     AuditEvent[]     @relation("AuditActorMembership")

  @@unique([userId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@index([tenantId, activeFrom, activeUntil])
}

model TeamMember {
  id           String     @id @default(uuid())
  tenantId     String
  teamId       String
  membershipId String
  createdAt    DateTime   @default(now())
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  team         Team       @relation(fields: [teamId, tenantId], references: [id, tenantId], onDelete: Restrict)
  membership   Membership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([teamId, membershipId])
  @@index([tenantId, membershipId])
}

// Phase 4: Tenant-owned settings engine. Structured key/value configuration
// that can be extended without code changes (deferred catalog domains such as
// practice areas, case types, statuses, numbering rules, branding and locale
// tokens are stored here as versioned JSON until a later phase promotes them
// to first-class models). `key` is namespaced (`catalog.case-type`, etc.).
model OrganizationSetting {
  id          String   @id @default(uuid())
  tenantId    String
  key         String
  value       Json
  status      String   @default("ACTIVE")
  version     Int      @default(1)
  updatedByMembershipId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId, status])
}

model Invitation {
  id                      String           @id @default(uuid())
  tenantId                String
  inviterMembershipId     String
  tokenHash               String           @unique
  intendedEmailNormalized String?
  intendedProviderSubject String?
  requestedRoleKeys       Json
  requestedScope          Json?
  status                  InvitationStatus @default(PENDING)
  expiresAt               DateTime
  acceptedAt              DateTime?
  revokedAt               DateTime?
  rejectedAt              DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  tenant                  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inviterMembership       Membership       @relation("InvitationInviterMembership", fields: [inviterMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, status, expiresAt])
  @@index([intendedEmailNormalized, status])
  @@index([intendedProviderSubject, status])
}

// Global immutable permission catalog.
model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

// Global catalog roles and tenant-defined roles. Tenant roles carry tenantId.
model Role {
  id                String                 @id @default(uuid())
  tenantId          String?
  scope             RoleScope
  key               String
  name              String
  description       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenant            Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions       RolePermission[]
  membershipRoles   MembershipRole[]
  globalAssignments GlobalRoleAssignment[]

  @@unique([id, tenantId])
  @@unique([tenantId, key])
  @@index([scope, tenantId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
}

model MembershipRole {
  id           String     @id @default(uuid())
  tenantId     String
  membershipId String
  roleId       String
  assignedAt   DateTime   @default(now())
  revokedAt    DateTime?
  membership   Membership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  role         Role       @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([tenantId, roleId, revokedAt])
}

model GlobalRoleAssignment {
  id         String    @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId, revokedAt])
}

// Tenant-owned explicit denials.
model AccessDenial {
  id                    String       @id @default(uuid())
  tenantId              String
  subjectUserId         String?
  permissionKey         String
  resourceType          String?
  resourceId            String?
  reason                String
  status                DenialStatus @default(ACTIVE)
  startsAt              DateTime     @default(now())
  endsAt                DateTime?
  createdByMembershipId String
  revokedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subjectUser           User?        @relation("DenialSubjectUser", fields: [subjectUserId], references: [id], onDelete: Restrict)
  createdByMembership   Membership   @relation("DenialCreatedByMembership", fields: [createdByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, status, permissionKey])
  @@index([tenantId, resourceType, resourceId])
  @@index([subjectUserId, status])
}

// Append-only audit/security event store (Phase 2). Written in the same
// transaction as the state change it records; never updated or deleted by the
// application runtime roles (enforced by migration-level privileges and a
// reject-immutable-mutation trigger). `tenantId` is null only for
// provider/global-boundary authentication events.
model AuditEvent {
  id                String         @id @default(uuid())
  eventType         String
  eventVersion      Int
  category          AuditCategory
  outcome           AuditOutcome
  actorUserId       String?
  actorMembershipId String?
  tenantId          String?
  targetType        String?
  targetId          String?
  policy            String?
  reasonCode        String?
  correlationId     String
  traceId           String?
  ipHash            String?
  userAgentHash     String?
  metadata          Json           @default("{}")
  occurredAt        DateTime       @default(now())
  createdAt         DateTime       @default(now())
  retentionUntil    DateTime
  actorUser         User?          @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership   Membership?    @relation("AuditActorMembership", fields: [actorMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant            Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, eventType, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([correlationId])
  @@index([retentionUntil])
}

// One-time Platform bootstrap marker. A row exists only after the operator
// bootstrap has succeeded; its presence is the "secret already used, cannot
// repeat" gate. `singleton` is always true and carries a unique constraint so
// the database itself permits at most one marker row even under a concurrent
// bootstrap race. Global/no-RLS table so the gate is readable before any
// tenant context exists.
model PlatformBootstrap {
  id             String   @id @default(uuid())
  singleton      Boolean  @default(true)
  completedAt    DateTime @default(now())
  operatorUserId String
  tenantId       String
  secretHash     String

  operatorUser User   @relation("BootstrapOperatorUser", fields: [operatorUserId], references: [id], onDelete: Restrict)
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([singleton])
  @@index([operatorUserId])
  @@index([tenantId])
}

// Phase 5: tenant-scoped Client — an individual or organization counterparty.
// `displayName` is denormalized for case-insensitive search/filter over the list
// endpoint (W4). `status` uses the soft-archive HierarchyStatus (ACTIVE/ARCHIVED);
// a client is never hard-deleted. `source` and `status` remain free-form TEXT,
// deferring catalog promotion to the OrganizationSetting engine. Contacts /
// addresses / identifiers / tags / notes / documents / communications are
// deferred to sequenced Phase 5 follow-ups.
model Client {
  id          String         @id @default(uuid())
  tenantId    String
  clientType  ClientType
  name        String
  legalName   String?
  displayName String
  status      HierarchyStatus @default(ACTIVE)
  source      String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contacts    ClientContact[]
  addresses   ClientAddress[]
  conflictChecks ConflictCheck[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, clientType])
}

// Phase 5 follow-up: contact channels for a Client (phone, email, etc.). Always
// scoped to the same tenant as the parent Client — a contact can never point at
// a Client in another tenant. `isPrimary` is enforced at the service layer (a
// client has at most one primary of a given type).
model ClientContact {
  id          String            @id @default(uuid())
  tenantId    String
  clientId    String
  type        ClientContactType
  value       String
  label       String?
  isPrimary   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, clientId])
  @@index([clientId, type])
}

// Phase 5 follow-up: physical addresses for a Client. Same tenant isolation as
// ClientContact; `isPrimary` enforced at the service layer.
model ClientAddress {
  id         String            @id @default(uuid())
  tenantId   String
  clientId   String
  type       ClientAddressType
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String
  isPrimary  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, clientId])
}

// Phase 6: Conflict Check Foundation — a request-to-decision workflow for
// screening prospective parties before a matter/case is accepted. Each check
// captures the requester, an optional client being checked for, normalized
// party inputs (ConflictParty), and a final reviewer decision (ALLOW/BLOCK)
// with reason. The acceptance-gate contract (`assertClearForCase`) will be
// invoked by the Matter/Case acceptance flow in Phase 7/8.
model ConflictCheck {
  id                String              @id @default(uuid())
  tenantId          String
  status            ConflictCheckStatus @default(PENDING)
  requesterUserId   String
  clientId          String?
  decision          ConflictDecision    @default(PENDING)
  reason            String?
  reviewerUserId    String?
  reviewedAt        DateTime?
  matchSummary      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client            Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  parties           ConflictParty[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
}

// Phase 6: normalized party inputs for a ConflictCheck. Each party has a
// kind (PARTY or RELATED_ENTITY), a display name, a normalized name (lowercased,
// trimmed), and an optional email. The deterministic match service scans these
// against Client.displayName and ClientContact.value to surface collisions.
model ConflictParty {
  id              String           @id @default(uuid())
  tenantId        String
  conflictCheckId String
  kind            ConflictPartyType
  name            String
  normalizedName  String
  email           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  conflictCheck   ConflictCheck    @relation(fields: [conflictCheckId], references: [id], onDelete: Cascade)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, conflictCheckId])
}
