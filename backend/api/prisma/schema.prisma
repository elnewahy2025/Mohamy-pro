generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Phase 1: Health check table to prove migrations work
model Health {
  id        String   @id @default(uuid())
  status    String   @default("OK")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// Phase 1: Storage security metadata foundation.
model StorageObject {
  id                String    @id @default(uuid())
  key               String
  versionId         String?
  sha256            String    @db.VarChar(64)
  sizeBytes         BigInt
  contentType       String
  encryptionMode    String
  malwareStatus     String    @default("PENDING_SCAN")
  malwareScannedAt  DateTime?
  retentionUntil    DateTime?
  legalHold         Boolean   @default(false)
  metadata          Json?
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  @@unique([key, versionId])
  @@index([malwareStatus, createdAt])
  @@index([retentionUntil, legalHold])
}

// Phase 1: Transactional outbox table skeleton
model OutboxMessage {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status         String    @default("PENDING") // PENDING, PROCESSING, PROCESSED, FAILED, DEAD_LETTER
  error          String?
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  claimedAt      DateTime?
  leaseToken     String?
  deadLetteredAt DateTime?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@index([status, availableAt, createdAt])
  @@index([status, claimedAt])
  @@index([aggregateType, aggregateId])
}

// Phase 1: Idempotency registry skeleton
model IdempotencyKey {
  key            String   @id
  userId         String?
  tenantId       String?
  requestPath    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@index([tenantId, userId])
}
