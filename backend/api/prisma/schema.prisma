generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  DELETED
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum HierarchyStatus {
  ACTIVE
  ARCHIVED
}

// Phase 5: discriminator for the Client entity — an individual person or an
// organization (plan/legal counterparty). Deliberately not an organization-hierarchy
// entity; a Client organization is a counterparty, while Organization/Branch/
// Department/Team are the practice's own structure (Phase 4). See Phase 7 for
// separating legal parties from clients.
enum ClientType {
  INDIVIDUAL
  ORGANIZATION
}

// Phase 5 follow-up: how a Client can be contacted. Strict enough to be an enum;
// a client is not expected to carry arbitrary, open-ended contact kinds.
enum ClientContactType {
  PHONE
  EMAIL
  FAX
  WEBSITE
  MOBILE
}

// Phase 5 follow-up: the role/purpose of a Client's physical address.
enum ClientAddressType {
  MAILING
  BILLING
  REGISTERED
  BRANCH
}

// Phase 6: Conflict Check workflow lifecycle status. A check starts PENDING,
// moves to IN_REVIEW when a reviewer begins evaluation, and reaches the
// terminal COMPLETED state once a final decision (ALLOW/BLOCK) is recorded.
enum ConflictCheckStatus {
  PENDING
  IN_REVIEW
  COMPLETED
}

// Phase 6: the final decision recorded on a ConflictCheck. A PENDING decision
// means no reviewer has finalized yet; ALLOW means no conflict was found (or
// the conflict was deemed manageable); BLOCK means the conflict is prohibitive
// and a future matter/case acceptance must not proceed.
enum ConflictDecision {
  PENDING
  ALLOW
  BLOCK
}

// Phase 6: kind of prospective party on a ConflictCheck — either a direct
// party (plaintiff, defendant, etc.) or a related entity (parent company,
// subsidiary, affiliated org, etc.).
enum ConflictPartyType {
  PARTY
  RELATED_ENTITY
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  EXPIRED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  REJECTED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RoleScope {
  GLOBAL
  TENANT
}

enum DenialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuditCategory {
  AUDIT
  SECURITY
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED
  REVOKED
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
  PRIVILEGED
  RESTRICTED
}

// Phase 8: Matter / Case Management
enum CaseStatus {
  OPEN
  CLOSED
  ON_HOLD
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CaseTimelineEventType {
  CASE_CREATED
  CLIENT_ADDED
  PARTY_ADDED
  DOCUMENT_UPLOADED
  TASK_CREATED
  HEARING_SCHEDULED
  DEADLINE_CREATED
  STATUS_CHANGED
  NOTE_ADDED
  INVOICE_CREATED
  PAYMENT_RECEIVED
  DOCUMENT_APPROVED
  CASE_CLOSED
}

// Phase 1: Health check table to prove migrations work
model Health {
  id        String   @id @default(uuid())
  status    String   @default("OK")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// Phase 1: Storage security metadata foundation.
model StorageObject {
  id               String             @id @default(uuid())
  tenantId         String
  key              String
  versionId        String?
  sha256           String             @db.VarChar(64)
  sizeBytes        BigInt
  contentType      String
  encryptionMode   String
  malwareStatus    String             @default("PENDING_SCAN")
  malwareScannedAt DateTime?
  retentionUntil   DateTime?
  legalHold        Boolean            @default(false)
  classification   DataClassification @default(CONFIDENTIAL)
  metadata         Json?
  createdAt        DateTime           @default(now())
  deletedAt        DateTime?
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([key, versionId])
  @@index([malwareStatus, createdAt])
  @@index([retentionUntil, legalHold])
  @@index([tenantId, createdAt])
}

// Phase 1: Transactional outbox table skeleton
model OutboxMessage {
  id             String    @id @default(uuid())
  tenantId       String?
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  status         String    @default("PENDING") // PENDING, PROCESSING, PROCESSED, FAILED, DEAD_LETTER
  error          String?
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  claimedAt      DateTime?
  leaseToken     String?
  deadLetteredAt DateTime?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status, availableAt, createdAt])
  @@index([status, claimedAt])
  @@index([aggregateType, aggregateId])
  @@index([tenantId, status, availableAt])
}

// Phase 1: Idempotency registry skeleton
enum IdempotencyState {
  RESERVED
  COMPLETED
  FAILED
}

model IdempotencyKey {
  // Phase 2: typed server-derived tenant boundary. tenantScope remains the
  // persisted string lookup scope; tenantId is the typed FK used by RLS.
  id              String           @id @default(uuid())
  key             String
  actorScope      String?
  tenantScope     String?
  tenantId        String?
  method          String
  route           String
  fingerprint     String
  state           IdempotencyState @default(RESERVED)
  responseStatus  Int?
  responseBody    Json?
  responseHeaders Json?
  attemptVersion  Int              @default(0)
  reservedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  expiresAt       DateTime
  requestId       String?
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "IdempotencyKey_tenantId_fkey")

  @@unique([key, actorScope, tenantScope, method, route])
  @@index([expiresAt])
  @@index([state, expiresAt])
  @@index([tenantId])
}

// Phase 2: Global application identity. Provider credentials and MFA secrets are not stored here.
model User {
  id                       String                     @id @default(uuid())
  status                   UserStatus                 @default(PENDING)
  emailNormalized          String?                    @unique
  displayName              String?
  givenName                String?
  familyName               String?
  locale                   String                     @default("en")
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  deletedAt                DateTime?
  externalIdentities       ExternalIdentity[]
  sessions                 AppSession[]
  memberships              Membership[]
  globalRoleAssignments    GlobalRoleAssignment[]
  denials                  AccessDenial[]             @relation("DenialSubjectUser")
  auditEvents              AuditEvent[]               @relation("AuditActorUser")
  platformBootstraps       PlatformBootstrap[]        @relation("BootstrapOperatorUser")
  signedAccessGrants       SignedAccessGrant[]
  documentDownloads        DocumentDownload[]
  humanReviews             HumanReview[]
  approvedDocumentMetadata ApprovedDocumentMetadata[]

  @@index([status, createdAt])
}

// Phase 2: Immutable provider subject mapping. Email matching never links identities implicitly.
model ExternalIdentity {
  id                  String    @id @default(uuid())
  userId              String
  provider            String
  subject             String
  providerSessionId   String?
  lastAuthenticatedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@index([userId])
}

// Phase 2: Server-mediated opaque application session. Tokens are stored only as hashes/ciphertext.
model AppSession {
  id                             String        @id @default(uuid())
  userId                         String
  tokenHash                      String        @unique
  csrfTokenHash                  String        @unique
  status                         SessionStatus @default(ACTIVE)
  provider                       String
  providerSubject                String
  providerSessionId              String?
  activeTenantId                 String?
  activeMembershipId             String?
  contextVersion                 Int           @default(0)
  createdAt                      DateTime      @default(now())
  lastUsedAt                     DateTime      @default(now())
  idleExpiresAt                  DateTime
  absoluteExpiresAt              DateTime
  mfaVerifiedAt                  DateTime?
  mfaAcr                         String?
  mfaAmr                         Json?
  providerRefreshTokenCiphertext String?
  providerRefreshTokenKeyVersion String?
  providerIdTokenCiphertext      String?
  userAgentHash                  String?
  ipHash                         String?
  revokedAt                      DateTime?
  revokedReason                  String?
  user                           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeTenant                   Tenant?       @relation("SessionActiveTenant", fields: [activeTenantId], references: [id], onDelete: SetNull)
  activeMembership               Membership?   @relation("SessionActiveMembership", fields: [activeMembershipId, activeTenantId], references: [id, tenantId], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, activeTenantId, status])
  @@index([activeTenantId, status])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

// Phase 2: Primary ordinary data-security boundary.
model Tenant {
  id                       String                     @id @default(uuid())
  slug                     String                     @unique
  name                     String
  externalIdentifier       String?                    @unique
  status                   TenantStatus               @default(PENDING)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  archivedAt               DateTime?
  organizations            Organization[]
  branches                 Branch[]
  clients                  Client[]
  clientContacts           ClientContact[]
  clientAddresses          ClientAddress[]
  departments              Department[]
  teams                    Team[]
  memberships              Membership[]
  activeSessions           AppSession[]               @relation("SessionActiveTenant")
  invitations              Invitation[]
  roles                    Role[]
  denials                  AccessDenial[]
  teamMembers              TeamMember[]
  storageObjects           StorageObject[]
  outboxMessages           OutboxMessage[]
  auditEvents              AuditEvent[]
  platformBootstraps       PlatformBootstrap[]
  idempotencyKeys          IdempotencyKey[]
  organizationSettings     OrganizationSetting[]
  conflictChecks           ConflictCheck[]
  conflictParties          ConflictParty[]
  parties                  Party[]
  partyRoles               PartyRole[]
  partyRelationships       PartyRelationship[]
  cases                    Case[]
  caseParties              CaseParty[]
  jurisdictions            Jurisdiction[]
  courts                   Court[]
  courtLocations           CourtLocation[]
  caseTimelineEvents       CaseTimelineEvent[]
  workflows                Workflow[]
  workflowVersions         WorkflowVersion[]
  workflowStates           WorkflowState[]
  workflowTransitions      WorkflowTransition[]
  hearings                 Hearing[]
  deadlineRules            DeadlineRule[]
  deadlines                Deadline[]
  tasks                    Task[]
  taskChecklists           TaskChecklist[]
  taskDependencies         TaskDependency[]
  documents                Document[]
  documentVersions         DocumentVersion[]
  documentTags             DocumentTag[]
  documentMetadatas        DocumentMetadata[]
  documentShares           DocumentShare[]
  documentAccesses         DocumentAccess[]
  documentSecurityMetadata DocumentSecurityMetadata[]
  documentScans            DocumentScan[]
  signedAccessGrants       SignedAccessGrant[]
  documentDownloads        DocumentDownload[]
  ocrProcessings           OcrProcessing[]
  approvedDocumentMetadata ApprovedDocumentMetadata[]
  searchReindexJobs        SearchReindexJob[]
  templates                Template[]
  templateVersions         TemplateVersion[]
  templateApprovals        TemplateApproval[]
  documentGenerationJobs   DocumentGenerationJob[]

  @@index([status, createdAt])
}

model Organization {
  id        String          @id @default(uuid())
  tenantId  String
  slug      String
  name      String
  status    HierarchyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches  Branch[]

  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model Branch {
  id             String          @id @default(uuid())
  tenantId       String
  organizationId String
  slug           String
  name           String
  status         HierarchyStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization   Organization    @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  departments    Department[]

  @@unique([id, tenantId])
  @@unique([tenantId, organizationId, slug])
  @@index([tenantId, status])
}

model Department {
  id        String          @id @default(uuid())
  tenantId  String
  branchId  String
  slug      String
  name      String
  status    HierarchyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch    Branch          @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, branchId, slug])
  @@index([tenantId, status])
}

// Team is an assignment construct, not an alternate security boundary.
model Team {
  id          String          @id @default(uuid())
  tenantId    String
  slug        String
  name        String
  description String?
  status      HierarchyStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  members     TeamMember[]

  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

// Membership is the source of ordinary tenant context.
model Membership {
  id                String             @id @default(uuid())
  tenantId          String
  userId            String
  status            MembershipStatus   @default(INVITED)
  activeFrom        DateTime?
  activeUntil       DateTime?
  invitedAt         DateTime?
  activatedAt       DateTime?
  suspendedAt       DateTime?
  removedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeSessions    AppSession[]       @relation("SessionActiveMembership")
  roles             MembershipRole[]
  teamMembers       TeamMember[]
  invitationsSent   Invitation[]       @relation("InvitationInviterMembership")
  denialsCreated    AccessDenial[]     @relation("DenialCreatedByMembership")
  auditEvents       AuditEvent[]       @relation("AuditActorMembership")
  hearings          Hearing[]
  deadlines         Deadline[]
  tasksAssigned     Task[]             @relation("TaskAssignee")
  tasksReported     Task[]             @relation("TaskReporter")
  documentsUploaded Document[]         @relation("DocumentUploader")
  documentVersions  DocumentVersion[]  @relation("DocumentVersionCreator")
  documentShares    DocumentShare[]    @relation("DocumentSharer")
  documentAccesses  DocumentAccess[]   @relation("DocumentAccessor")
  documentDownloads DocumentDownload[]

  @@unique([userId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@index([tenantId, activeFrom, activeUntil])
}

model TeamMember {
  id           String     @id @default(uuid())
  tenantId     String
  teamId       String
  membershipId String
  createdAt    DateTime   @default(now())
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  team         Team       @relation(fields: [teamId, tenantId], references: [id, tenantId], onDelete: Restrict)
  membership   Membership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([teamId, membershipId])
  @@index([tenantId, membershipId])
}

// Phase 4: Tenant-owned settings engine. Structured key/value configuration
// that can be extended without code changes (deferred catalog domains such as
// practice areas, case types, statuses, numbering rules, branding and locale
// tokens are stored here as versioned JSON until a later phase promotes them
// to first-class models). `key` is namespaced (`catalog.case-type`, etc.).
model OrganizationSetting {
  id                    String   @id @default(uuid())
  tenantId              String
  key                   String
  value                 Json
  status                String   @default("ACTIVE")
  version               Int      @default(1)
  updatedByMembershipId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId, status])
}

// Phase 8: Canonical Case/Matter Record
model Case {
  id             String       @id @default(uuid())
  tenantId       String
  caseNumber     String
  internalNumber String?
  clientId       String
  practiceArea   String?
  caseType       String?
  status         CaseStatus   @default(OPEN)
  priority       CasePriority @default(NORMAL)
  openDate       DateTime?
  closeDate      DateTime?

  workflowVersionId String?
  currentStateId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  parties        CaseParty[]
  timelineEvents CaseTimelineEvent[]

  workflowVersion        WorkflowVersion?        @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  currentState           WorkflowState?          @relation(fields: [currentStateId], references: [id], onDelete: Restrict)
  hearings               Hearing[]
  deadlines              Deadline[]
  tasks                  Task[]
  documents              Document[]
  documentGenerationJobs DocumentGenerationJob[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId, status])
}

// Phase 8: Physical implementation of Phase 7 CasePartyContract
model CaseParty {
  id        String          @id @default(uuid())
  tenantId  String
  caseId    String
  partyId   String
  roleId    String
  status    HierarchyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case   Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  party  Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  role   PartyRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, caseId, partyId, roleId])
  @@index([tenantId, caseId])
  @@index([tenantId, partyId])
}

// Phase 10: Case Timeline Foundation
model CaseTimelineEvent {
  id                String                @id @default(uuid())
  tenantId          String
  caseId            String
  eventType         CaseTimelineEventType
  occurredAt        DateTime              @default(now())
  actorUserId       String?
  actorMembershipId String?
  payload           Json?                 @db.JsonB
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, caseId, occurredAt])
}

model Invitation {
  id                      String           @id @default(uuid())
  tenantId                String
  inviterMembershipId     String
  tokenHash               String           @unique
  intendedEmailNormalized String?
  intendedProviderSubject String?
  requestedRoleKeys       Json
  requestedScope          Json?
  status                  InvitationStatus @default(PENDING)
  expiresAt               DateTime
  acceptedAt              DateTime?
  revokedAt               DateTime?
  rejectedAt              DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  tenant                  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inviterMembership       Membership       @relation("InvitationInviterMembership", fields: [inviterMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, status, expiresAt])
  @@index([intendedEmailNormalized, status])
  @@index([intendedProviderSubject, status])
}

// Global immutable permission catalog.
model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

// Global catalog roles and tenant-defined roles. Tenant roles carry tenantId.
model Role {
  id                String                 @id @default(uuid())
  tenantId          String?
  scope             RoleScope
  key               String
  name              String
  description       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenant            Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions       RolePermission[]
  membershipRoles   MembershipRole[]
  globalAssignments GlobalRoleAssignment[]

  @@unique([id, tenantId])
  @@unique([tenantId, key])
  @@index([scope, tenantId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
}

model MembershipRole {
  id           String     @id @default(uuid())
  tenantId     String
  membershipId String
  roleId       String
  assignedAt   DateTime   @default(now())
  revokedAt    DateTime?
  membership   Membership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  role         Role       @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([tenantId, roleId, revokedAt])
}

model GlobalRoleAssignment {
  id         String    @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId, revokedAt])
}

// Tenant-owned explicit denials.
model AccessDenial {
  id                    String       @id @default(uuid())
  tenantId              String
  subjectUserId         String?
  permissionKey         String
  resourceType          String?
  resourceId            String?
  reason                String
  status                DenialStatus @default(ACTIVE)
  startsAt              DateTime     @default(now())
  endsAt                DateTime?
  createdByMembershipId String
  revokedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subjectUser           User?        @relation("DenialSubjectUser", fields: [subjectUserId], references: [id], onDelete: Restrict)
  createdByMembership   Membership   @relation("DenialCreatedByMembership", fields: [createdByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, status, permissionKey])
  @@index([tenantId, resourceType, resourceId])
  @@index([subjectUserId, status])
}

// Append-only audit/security event store (Phase 2). Written in the same
// transaction as the state change it records; never updated or deleted by the
// application runtime roles (enforced by migration-level privileges and a
// reject-immutable-mutation trigger). `tenantId` is null only for
// provider/global-boundary authentication events.
model AuditEvent {
  id                String        @id @default(uuid())
  eventType         String
  eventVersion      Int
  category          AuditCategory
  outcome           AuditOutcome
  actorUserId       String?
  actorMembershipId String?
  tenantId          String?
  targetType        String?
  targetId          String?
  policy            String?
  reasonCode        String?
  correlationId     String
  traceId           String?
  ipHash            String?
  userAgentHash     String?
  metadata          Json          @default("{}")
  occurredAt        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  retentionUntil    DateTime
  actorUser         User?         @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership   Membership?   @relation("AuditActorMembership", fields: [actorMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant            Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, eventType, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([correlationId])
  @@index([retentionUntil])
}

// One-time Platform bootstrap marker. A row exists only after the operator
// bootstrap has succeeded; its presence is the "secret already used, cannot
// repeat" gate. `singleton` is always true and carries a unique constraint so
// the database itself permits at most one marker row even under a concurrent
// bootstrap race. Global/no-RLS table so the gate is readable before any
// tenant context exists.
model PlatformBootstrap {
  id             String   @id @default(uuid())
  singleton      Boolean  @default(true)
  completedAt    DateTime @default(now())
  operatorUserId String
  tenantId       String
  secretHash     String

  operatorUser User   @relation("BootstrapOperatorUser", fields: [operatorUserId], references: [id], onDelete: Restrict)
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([singleton])
  @@index([operatorUserId])
  @@index([tenantId])
}

// Phase 5: tenant-scoped Client — an individual or organization counterparty.
// `displayName` is denormalized for case-insensitive search/filter over the list
// endpoint (W4). `status` uses the soft-archive HierarchyStatus (ACTIVE/ARCHIVED);
// a client is never hard-deleted. `source` and `status` remain free-form TEXT,
// deferring catalog promotion to the OrganizationSetting engine. Contacts /
// addresses / identifiers / tags / notes / documents / communications are
// deferred to sequenced Phase 5 follow-ups.
model Client {
  id                     String                  @id @default(uuid())
  tenantId               String
  clientType             ClientType
  name                   String
  legalName              String?
  displayName            String
  status                 HierarchyStatus         @default(ACTIVE)
  source                 String?
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contacts               ClientContact[]
  addresses              ClientAddress[]
  conflictChecks         ConflictCheck[]
  documents              Document[]
  parties                Party[]
  cases                  Case[]
  documentGenerationJobs DocumentGenerationJob[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, clientType])
}

// Phase 5 follow-up: contact channels for a Client (phone, email, etc.). Always
// scoped to the same tenant as the parent Client — a contact can never point at
// a Client in another tenant. `isPrimary` is enforced at the service layer (a
// client has at most one primary of a given type).
model ClientContact {
  id        String            @id @default(uuid())
  tenantId  String
  clientId  String
  type      ClientContactType
  value     String
  label     String?
  isPrimary Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, clientId])
  @@index([clientId, type])
}

// Phase 5 follow-up: physical addresses for a Client. Same tenant isolation as
// ClientContact; `isPrimary` enforced at the service layer.
model ClientAddress {
  id         String            @id @default(uuid())
  tenantId   String
  clientId   String
  type       ClientAddressType
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String
  isPrimary  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, clientId])
}

// Phase 6: Conflict Check Foundation — a request-to-decision workflow for
// screening prospective parties before a matter/case is accepted. Each check
// captures the requester, an optional client being checked for, normalized
// party inputs (ConflictParty), and a final reviewer decision (ALLOW/BLOCK)
// with reason. The acceptance-gate contract (`assertClearForCase`) will be
// invoked by the Matter/Case acceptance flow in Phase 7/8.
model ConflictCheck {
  id              String              @id @default(uuid())
  tenantId        String
  status          ConflictCheckStatus @default(PENDING)
  requesterUserId String
  clientId        String?
  decision        ConflictDecision    @default(PENDING)
  reason          String?
  reviewerUserId  String?
  reviewedAt      DateTime?
  matchSummary    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client          Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  parties         ConflictParty[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
}

// Phase 6: normalized party inputs for a ConflictCheck. Each party has a
// kind (PARTY or RELATED_ENTITY), a display name, a normalized name (lowercased,
// trimmed), and an optional email. The deterministic match service scans these
// against Client.displayName and ClientContact.value to surface collisions.
model ConflictParty {
  id              String            @id @default(uuid())
  tenantId        String
  conflictCheckId String
  kind            ConflictPartyType
  name            String
  normalizedName  String
  email           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  conflictCheck   ConflictCheck     @relation(fields: [conflictCheckId], references: [id], onDelete: Cascade)
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, conflictCheckId])
}

// Phase 7: Party Management
enum PartyType {
  PERSON
  ORGANIZATION
}

// A generic Party separated from a Client, supporting legal structuring.
model Party {
  id          String          @id @default(uuid())
  tenantId    String
  partyType   PartyType
  name        String?
  legalName   String?
  displayName String
  status      HierarchyStatus @default(ACTIVE)
  clientId    String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client            Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  relationshipsFrom PartyRelationship[] @relation("PartyRelationshipsFrom")
  relationshipsTo   PartyRelationship[] @relation("PartyRelationshipsTo")
  caseParties       CaseParty[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
}

// Configurable role catalog for Parties.
model PartyRole {
  id        String          @id @default(uuid())
  tenantId  String
  key       String
  label     String
  status    HierarchyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  caseParties CaseParty[]

  @@unique([tenantId, key])
}

// Tenant-scoped party-to-party relationships.
model PartyRelationship {
  id               String          @id @default(uuid())
  tenantId         String
  fromPartyId      String
  toPartyId        String
  relationshipType String
  status           HierarchyStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromParty Party  @relation("PartyRelationshipsFrom", fields: [fromPartyId], references: [id], onDelete: Restrict)
  toParty   Party  @relation("PartyRelationshipsTo", fields: [toPartyId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, fromPartyId])
}

// Phase 9: Legal Configuration - Country
model Country {
  id        String          @id @default(uuid())
  code      String          @unique
  name      String
  status    HierarchyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  jurisdictions Jurisdiction[]
}

// Phase 9: Legal Configuration - Jurisdiction (Hybrid Tenancy)
model Jurisdiction {
  id        String          @id @default(uuid())
  tenantId  String?
  countryId String
  name      String
  status    HierarchyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courts  Court[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
}

// Phase 9: Legal Configuration - Court (Hybrid Tenancy)
model Court {
  id             String          @id @default(uuid())
  tenantId       String?
  jurisdictionId String
  name           String
  courtType      String?
  department     String?
  status         HierarchyStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  jurisdiction Jurisdiction    @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  tenant       Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  locations    CourtLocation[]
  hearings     Hearing[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
}

// Phase 9: Legal Configuration - Court Location (Hybrid Tenancy)
model CourtLocation {
  id        String          @id @default(uuid())
  tenantId  String?
  courtId   String
  name      String
  city      String?
  address   String?
  status    HierarchyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  court    Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hearings Hearing[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
}

// Phase 11: Workflow Engine Foundation

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model Workflow {
  id        String          @id @default(uuid())
  tenantId  String
  name      String
  caseType  String?
  status    HierarchyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  versions WorkflowVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model WorkflowVersion {
  id            String                @id @default(uuid())
  tenantId      String
  workflowId    String
  version       Int
  status        WorkflowVersionStatus @default(DRAFT)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workflow    Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  states      WorkflowState[]
  transitions WorkflowTransition[]
  cases       Case[]

  @@unique([tenantId, workflowId, version])
  @@index([tenantId, workflowId, status])
}

model WorkflowState {
  id        String   @id @default(uuid())
  tenantId  String
  versionId String
  name      String
  isInitial Boolean  @default(false)
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  version             WorkflowVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  outgoingTransitions WorkflowTransition[] @relation("FromState")
  incomingTransitions WorkflowTransition[] @relation("ToState")
  cases               Case[]

  @@unique([tenantId, versionId, name])
}

model WorkflowTransition {
  id               String   @id @default(uuid())
  tenantId         String
  versionId        String
  fromStateId      String?
  toStateId        String
  conditions       Json?
  actions          Json?
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  version   WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromState WorkflowState?  @relation("FromState", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState   WorkflowState   @relation("ToState", fields: [toStateId], references: [id], onDelete: Cascade)

  @@index([tenantId, versionId, fromStateId])
}

// Phase 12: Hearing Management

enum HearingStatus {
  SCHEDULED
  COMPLETED
  POSTPONED
  CANCELLED
}

model Hearing {
  id               String        @id @default(uuid())
  tenantId         String
  caseId           String
  courtId          String?
  courtLocationId  String?
  assignedLawyerId String?
  date             DateTime
  time             String?
  hearingType      String?
  status           HearingStatus @default(SCHEDULED)
  outcome          String?
  notes            String?
  nextHearingId    String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case           Case           @relation(fields: [caseId], references: [id], onDelete: Restrict)
  court          Court?         @relation(fields: [courtId], references: [id], onDelete: SetNull)
  courtLocation  CourtLocation? @relation(fields: [courtLocationId], references: [id], onDelete: SetNull)
  assignedLawyer Membership?    @relation(fields: [assignedLawyerId], references: [id], onDelete: SetNull)

  nextHearing     Hearing? @relation("HearingChain", fields: [nextHearingId], references: [id], onDelete: SetNull)
  previousHearing Hearing? @relation("HearingChain")

  @@index([tenantId, date])
  @@index([tenantId, caseId])
}

// Phase 13: Legal Deadline Engine

enum DeadlineStatus {
  PENDING
  COMPLETED
  OVERDUE
  CANCELLED
}

enum DeadlineType {
  FIXED
  RELATIVE
  RULE_BASED
  MANUAL
  RECURRING
}

model DeadlineRule {
  id             String    @id @default(uuid())
  tenantId       String
  name           String
  description    String?
  version        Int       @default(1)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  reminderRule   Json?
  escalationRule Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deadlines Deadline[]

  @@index([tenantId])
}

model Deadline {
  id                 String         @id @default(uuid())
  tenantId           String
  caseId             String
  title              String
  description        String?
  deadlineType       DeadlineType
  dueDate            DateTime
  status             DeadlineStatus @default(PENDING)
  ruleId             String?
  completionEvidence String?
  assignedUserId     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case         Case          @relation(fields: [caseId], references: [id], onDelete: Restrict)
  rule         DeadlineRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  assignedUser Membership?   @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, caseId])
  @@index([tenantId, dueDate])
}

// Phase 14: Task Management

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id             String       @id @default(uuid())
  tenantId       String
  caseId         String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  assignedUserId String?
  reporterUserId String?
  parentTaskId   String?
  recurringRule  Json?
  sla            Json?
  escalationRule Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case         Case?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedUser Membership? @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  reporterUser Membership? @relation("TaskReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)

  parentTask Task?  @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[] @relation("Subtasks")

  checklists   TaskChecklist[]
  dependencies TaskDependency[] @relation("TaskDependent")
  dependsOn    TaskDependency[] @relation("TaskPrerequisite")

  @@index([tenantId, caseId])
  @@index([tenantId, assignedUserId])
}

model TaskChecklist {
  id          String   @id @default(uuid())
  tenantId    String
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([tenantId])
}

model TaskDependency {
  id                 String   @id @default(uuid())
  tenantId           String
  dependentTaskId    String
  prerequisiteTaskId String
  createdAt          DateTime @default(now())

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dependent    Task   @relation("TaskDependent", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  prerequisite Task   @relation("TaskPrerequisite", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, prerequisiteTaskId])
  @@index([tenantId])
}

enum DocumentStatus {
  DRAFT
  FINAL
  ARCHIVED
}

model Document {
  id           String         @id @default(uuid())
  tenantId     String
  caseId       String?
  clientId     String?
  title        String
  description  String?
  documentType String? // e.g., 'CONTRACT', 'PLEADING', 'EVIDENCE'
  status       DocumentStatus @default(DRAFT)
  uploadedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case       Case?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  uploadedBy Membership? @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  versions                 DocumentVersion[]
  tags                     DocumentTag[]
  metadata                 DocumentMetadata[]
  shares                   DocumentShare[]
  accessRecords            DocumentAccess[]
  documentSecurityMetadata DocumentSecurityMetadata[]
  documentScans            DocumentScan[]
  signedAccessGrants       SignedAccessGrant[]
  documentDownloads        DocumentDownload[]
  ocrProcessings           OcrProcessing[]
  approvedDocumentMetadata ApprovedDocumentMetadata[]

  @@index([tenantId, caseId])
  @@index([tenantId, clientId])
}

model DocumentVersion {
  id              String   @id @default(uuid())
  tenantId        String
  documentId      String
  versionNumber   Int
  storageObjectId String // Reference to cloud storage / ObjectStorage UUID
  mimeType        String
  fileSize        BigInt
  checksum        String?
  createdAt       DateTime @default(now())
  createdById     String?

  tenant                   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document                 Document                   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy                Membership?                @relation("DocumentVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documentSecurityMetadata DocumentSecurityMetadata?
  documentScans            DocumentScan[]
  signedAccessGrants       SignedAccessGrant[]
  documentDownloads        DocumentDownload[]
  ocrProcessings           OcrProcessing[]
  approvedDocumentMetadata ApprovedDocumentMetadata[]

  @@unique([documentId, versionNumber])
  @@index([tenantId])
}

model DocumentTag {
  id         String @id @default(uuid())
  tenantId   String
  documentId String
  tag        String

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, tag])
  @@index([tenantId])
}

model DocumentMetadata {
  id         String @id @default(uuid())
  tenantId   String
  documentId String
  key        String
  value      String

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, key])
  @@index([tenantId])
}

model DocumentShare {
  id              String    @id @default(uuid())
  tenantId        String
  documentId      String
  sharedWithEmail String
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  createdById     String?

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document  Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy Membership? @relation("DocumentSharer", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model DocumentAccess {
  id           String   @id @default(uuid())
  tenantId     String
  documentId   String
  accessedById String?
  accessedAt   DateTime @default(now())
  action       String // e.g., 'VIEW', 'DOWNLOAD', 'PRINT'
  ipAddress    String?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accessedBy Membership? @relation("DocumentAccessor", fields: [accessedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// ==========================================
// Phase 16 - Document Security
// ==========================================

enum DocumentSecurityStatus {
  PENDING
  VALIDATING
  SCANNING
  APPROVED
  QUARANTINED
  REJECTED
  EXPIRED
  REVOKED
}

enum DocumentScanStatus {
  PENDING
  RUNNING
  CLEAN
  INFECTED
  FAILED
}

enum DocumentAccessPurpose {
  DOWNLOAD
  PREVIEW
  SHARE
}

enum DocumentDownloadResult {
  SUCCESS
  DENIED
  EXPIRED
  REVOKED
  QUARANTINED
  NOT_FOUND
}

model DocumentSecurityMetadata {
  id                    String                 @id @default(uuid())
  tenantId              String
  documentId            String
  documentVersionId     String                 @unique
  storageObjectId       String                 @unique
  securityStatus        DocumentSecurityStatus @default(PENDING)
  mimeTypeDetected      String?
  fileExtensionDetected String?
  fileSizeBytes         BigInt?
  sha256                String?
  contentHashAlgorithm  String?
  encryptionStatus      String?
  encryptionAlgorithm   String?
  keyReference          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, securityStatus])
  @@index([tenantId, sha256])
}

model DocumentScan {
  id                String             @id @default(uuid())
  tenantId          String
  documentId        String
  documentVersionId String
  scannerProvider   String
  scannerVersion    String?
  status            DocumentScanStatus @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?
  signatureVersion  String?
  threatName        String?
  resultMetadata    Json?
  createdAt         DateTime           @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model SignedAccessGrant {
  id                String                @id @default(uuid())
  tenantId          String
  documentId        String
  documentVersionId String
  storageObjectId   String
  issuedToUserId    String?
  purpose           DocumentAccessPurpose
  issuedAt          DateTime              @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  accessTokenId     String                @unique @default(uuid())

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document          Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion    @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  issuedToUser      User?              @relation(fields: [issuedToUserId], references: [id], onDelete: SetNull)
  documentDownloads DocumentDownload[]

  @@index([tenantId, documentId])
  @@index([tenantId, expiresAt])
}

model DocumentDownload {
  id                String                 @id @default(uuid())
  tenantId          String
  documentId        String
  documentVersionId String
  storageObjectId   String
  userId            String?
  membershipId      String?
  sessionId         String?
  accessGrantId     String?
  requestedAt       DateTime               @default(now())
  completedAt       DateTime?
  result            DocumentDownloadResult
  ip                String?
  userAgent         String?
  correlationId     String?

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document        Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion    @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership      Membership?        @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  accessGrant     SignedAccessGrant? @relation(fields: [accessGrantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// ==============================================================================
// Phase 17: Document OCR Pipeline
// ==============================================================================

enum OcrProcessingStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ExtractionMethod {
  NATIVE_TEXT
  OCR
}

enum HumanReviewStatus {
  NOT_REQUIRED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CORRECTION_REQUIRED
}

model OcrProcessing {
  id                String              @id @default(uuid())
  tenantId          String
  documentId        String
  documentVersionId String
  status            OcrProcessingStatus @default(QUEUED)
  attempt           Int                 @default(1)
  provider          String
  providerVersion   String?
  modelVersion      String?
  languageConfig    String?
  startedAt         DateTime            @default(now())
  completedAt       DateTime?
  failureCode       String?
  correlationId     String?
  jobId             String?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  pages           OcrPage[]
  entities        OcrEntity[]
  classifications ClassificationResult[]
  reviews         HumanReview[]
  approvedData    ApprovedDocumentMetadata[]

  @@index([tenantId])
}

model OcrPage {
  id               String           @id @default(uuid())
  ocrProcessingId  String
  pageNumber       Int
  extractionMethod ExtractionMethod
  text             String           @db.Text
  confidence       Float?
  metadata         Json?
  createdAt        DateTime         @default(now())

  processing OcrProcessing @relation(fields: [ocrProcessingId], references: [id], onDelete: Cascade)

  @@index([ocrProcessingId])
}

model OcrEntity {
  id               String   @id @default(uuid())
  ocrProcessingId  String
  pageId           String?
  entityType       String
  value            String   @db.Text
  normalizedValue  String?  @db.Text
  confidence       Float?
  sourceStart      Int?
  sourceEnd        Int?
  machineGenerated Boolean  @default(true)
  metadata         Json?
  createdAt        DateTime @default(now())

  processing OcrProcessing @relation(fields: [ocrProcessingId], references: [id], onDelete: Cascade)

  @@index([ocrProcessingId])
}

model ClassificationResult {
  id                String   @id @default(uuid())
  ocrProcessingId   String
  predictedCategory String
  confidence        Float?
  modelVersion      String?
  createdAt         DateTime @default(now())

  processing OcrProcessing @relation(fields: [ocrProcessingId], references: [id], onDelete: Cascade)

  @@index([ocrProcessingId])
}

model HumanReview {
  id              String            @id @default(uuid())
  ocrProcessingId String
  reviewerId      String?
  status          HumanReviewStatus @default(PENDING)
  decision        String?
  notes           String?           @db.Text
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())

  processing OcrProcessing @relation(fields: [ocrProcessingId], references: [id], onDelete: Cascade)
  reviewer   User?         @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([ocrProcessingId])
}

model ApprovedDocumentMetadata {
  id                String   @id @default(uuid())
  tenantId          String
  documentId        String
  documentVersionId String
  ocrProcessingId   String
  reviewerId        String?
  category          String?
  entities          Json?
  approvedAt        DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  processing      OcrProcessing   @relation(fields: [ocrProcessingId], references: [id], onDelete: Cascade)
  reviewer        User?           @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// ==============================================================================
// Phase 18: Search Subsystem
// ==============================================================================

enum SearchReindexStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model SearchIndexVersion {
  id         String   @id @default(uuid())
  entityType String
  indexName  String   @unique
  aliasName  String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  jobs SearchReindexJob[]
}

model SearchReindexJob {
  id             String              @id @default(uuid())
  tenantId       String?
  entityType     String
  targetIndexId  String
  status         SearchReindexStatus @default(PENDING)
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  error          String?             @db.Text
  totalItems     Int                 @default(0)
  processedItems Int                 @default(0)

  targetIndex SearchIndexVersion @relation(fields: [targetIndexId], references: [id], onDelete: Restrict)
  tenant      Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

// ==============================================================================
// Phase 19: Document Templates
// ==============================================================================

enum TemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ARCHIVED
}

enum TemplateVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETIRED
}

enum TemplateVariableType {
  STRING
  NUMBER
  DATE
  DATETIME
  BOOLEAN
  CURRENCY
  TEXT
  ENUM
}

enum TemplateVariableSource {
  MANUAL
  CASE
  CLIENT
  PARTY
  ORGANIZATION
  USER
  COMPUTED
}

enum TemplateVariableSensitivity {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SENSITIVE
  RESTRICTED
}

enum TemplateApprovalState {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentGenerationStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Template {
  id               String         @id @default(uuid())
  tenantId         String
  organizationId   String?
  name             String
  code             String
  description      String?
  documentTypeId   String?
  status           TemplateStatus @default(DRAFT)
  outputFormats    String[]
  currentVersionId String?
  createdBy        String
  updatedBy        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  archivedAt       DateTime?

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  versions TemplateVersion[]
  jobs     DocumentGenerationJob[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
}

model TemplateVersion {
  id               String                @id @default(uuid())
  templateId       String
  tenantId         String
  versionNumber    Int
  status           TemplateVersionStatus @default(DRAFT)
  sourceObjectId   String
  sourceSha256     String
  variableSchema   Json?
  templateMetadata Json?
  createdBy        String
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime              @default(now())
  retiredAt        DateTime?

  template  Template                @relation(fields: [templateId], references: [id], onDelete: Restrict)
  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  variables TemplateVariable[]
  approvals TemplateApproval[]
  jobs      DocumentGenerationJob[]

  @@unique([tenantId, templateId, versionNumber])
  @@index([tenantId, templateId, status])
}

model TemplateVariable {
  id                String                      @id @default(uuid())
  templateVersionId String
  key               String
  label             String
  dataType          TemplateVariableType
  required          Boolean                     @default(false)
  sourceType        TemplateVariableSource
  sourcePath        String?
  validationSchema  Json?
  defaultValue      Json?
  sensitivity       TemplateVariableSensitivity @default(INTERNAL)

  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
}

model TemplateApproval {
  id                String                @id @default(uuid())
  tenantId          String
  templateVersionId String
  requestedBy       String
  reviewerId        String?
  state             TemplateApprovalState @default(PENDING)
  decisionReason    String?
  requestedAt       DateTime              @default(now())
  decidedAt         DateTime?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, templateVersionId, state])
  @@index([tenantId, requestedBy])
}

model DocumentGenerationJob {
  id                String                   @id @default(uuid())
  tenantId          String
  templateId        String
  templateVersionId String
  caseId            String?
  clientId          String?
  requestedBy       String
  idempotencyKey    String
  status            DocumentGenerationStatus @default(QUEUED)
  requestedFormats  String[]
  inputSnapshot     Json?
  resultDocumentIds String[]
  errorCode         String?
  errorMessageSafe  String?
  attempts          Int                      @default(0)
  createdAt         DateTime                 @default(now())
  startedAt         DateTime?
  completedAt       DateTime?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template        Template        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  case            Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, templateId, createdAt])
}
