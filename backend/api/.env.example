NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://mohamy:mohamy_password@localhost:55432/mohamy_pro?schema=public
REDIS_URL=redis://localhost:56379
S3_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mohamy-development
S3_VERSIONING_ENABLED=true
S3_OBJECT_LOCK_ENABLED=false
S3_ENCRYPTION_MODE=NONE
S3_KMS_KEY_ID=
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CORS_ORIGINS=http://localhost:5173
METRICS_ENABLED=true
WORKER_METRICS_PORT=3002
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
METRICS_AUTH_TOKEN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mohamy-api

# Phase 2 abuse controls. Each value is bounded above by a reviewed production
# cap; a configured value above its bound fails startup. Defaults match the
# ABUSE_AND_IDENTITY_DATA_LIFECYCLE_DECISION threat model.
ABUSE_LOGIN_PER_IP_MAX=10
ABUSE_LOGIN_PER_IP_WINDOW_SECONDS=900
ABUSE_LOGIN_PER_IDENTIFIER_MAX=5
ABUSE_LOGIN_PER_IDENTIFIER_WINDOW_SECONDS=900
ABUSE_AUTH_FAILURE_THRESHOLD=5
ABUSE_LOCKOUT_SECONDS=900
ABUSE_MFA_PER_ACTOR_MAX=5
ABUSE_MFA_PER_ACTOR_WINDOW_SECONDS=900
ABUSE_INVITATION_MAX=10
ABUSE_INVITATION_WINDOW_SECONDS=3600
ABUSE_SWITCH_MAX=20
ABUSE_SWITCH_WINDOW_SECONDS=600
