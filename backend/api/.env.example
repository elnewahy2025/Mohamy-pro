NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public
# Direct, non-pooled connection for schema migrations when DATABASE_URL is pooled (e.g. PgBouncer).
DIRECT_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public
REDIS_URL=redis://<REDIS_HOST>:<REDIS_PORT>
S3_ENDPOINT=http://<S3_HOST>:<S3_PORT>
S3_ACCESS_KEY=<S3_ACCESS_KEY>
S3_SECRET_KEY=<S3_SECRET_KEY>
S3_BUCKET=<S3_BUCKET_NAME>
S3_VERSIONING_ENABLED=true
S3_OBJECT_LOCK_ENABLED=false
S3_ENCRYPTION_MODE=NONE
S3_KMS_KEY_ID=
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CORS_ORIGINS=http://localhost:5173
METRICS_ENABLED=true
WORKER_METRICS_PORT=3002
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
METRICS_AUTH_TOKEN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mohamy-api

# Phase 2 abuse controls. Each value is bounded above by a reviewed production
# cap; a configured value above its bound fails startup. Defaults match the
# ABUSE_AND_IDENTITY_DATA_LIFECYCLE_DECISION threat model.
ABUSE_LOGIN_PER_IP_MAX=10
ABUSE_LOGIN_PER_IP_WINDOW_SECONDS=900
ABUSE_LOGIN_PER_IDENTIFIER_MAX=5
ABUSE_LOGIN_PER_IDENTIFIER_WINDOW_SECONDS=900
ABUSE_AUTH_FAILURE_THRESHOLD=5
ABUSE_LOCKOUT_SECONDS=900
ABUSE_MFA_PER_ACTOR_MAX=5
ABUSE_MFA_PER_ACTOR_WINDOW_SECONDS=900
ABUSE_INVITATION_MAX=10
ABUSE_INVITATION_WINDOW_SECONDS=3600
ABUSE_SWITCH_MAX=20
ABUSE_SWITCH_WINDOW_SECONDS=600

# Data-retention cleanup (Phase B-H3). Days after which expired/dormant rows are
# purged by the scheduled cleanup jobs. Configurable at runtime via the future
# settings page; today these are env-provided defaults.
CLEANUP_OUTBOX_PROCESSED_DAYS=7
CLEANUP_OUTBOX_DEAD_LETTER_DAYS=30
CLEANUP_EXPIRED_SESSION_DAYS=30
CLEANUP_STORAGE_DAYS=30
