+// Phase 6: Conflict Check workflow lifecycle status. A check starts PENDING,
+// moves to IN_REVIEW when a reviewer begins evaluation, and reaches the
+// terminal COMPLETED state once a final decision (ALLOW/BLOCK) is recorded.
+enum ConflictCheckStatus {
+  PENDING
+  IN_REVIEW
+  COMPLETED
+}
+
+// Phase 6: the final decision recorded on a ConflictCheck. A PENDING decision
+// means no reviewer has finalized yet; ALLOW means no conflict was found (or
